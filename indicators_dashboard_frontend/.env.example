# Origin of the FastAPI backend, as seen from the user's browser.
# Inlined into the client bundle at build time, so it must be publicly
# reachable in a deployed environment. Never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: origin used for server-side rendering only. Set this when the
# Next.js server can reach the backend over a private network address that the
# browser cannot. Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# API_BASE_URL=http://127.0.0.1:8000

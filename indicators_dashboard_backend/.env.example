# Required. Claim a free key at https://www.alphavantage.co/support/#api-key
# This value never leaves the backend process: it is attached to outbound
# requests only, and is stripped from every response, error body, and log line.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# --- Everything below is optional; the defaults shown are what the app uses. ---

# Browser origins allowed to call this API. Comma-separated.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long a successful upstream response stays fresh, in seconds.
# Economic series are revised monthly at best, so a long TTL costs nothing and
# protects the free tier's budget of 25 requests per day.
# CACHE_TTL_SECONDS=21600

# How long an expired entry may still be served when Alpha Vantage is
# unavailable or rate limited. Responses served this way are flagged
# `meta.stale`. Set to 0 to disable stale-while-error.
# CACHE_STALE_GRACE_SECONDS=1209600

# Persist the cache to disk so a restart does not re-spend the daily quota.
# CACHE_PERSIST=true
# CACHE_DIR=.cache

# Upstream politeness. Alpha Vantage asks for at most ~1 request per second.
# MIN_SECONDS_BETWEEN_UPSTREAM_CALLS=1.1
# MAX_CONCURRENT_UPSTREAM_CALLS=1

# Transport behaviour.
# REQUEST_TIMEOUT_SECONDS=20
# MAX_RETRIES=2
# RETRY_BACKOFF_SECONDS=0.75

# Path prefix for the versioned API.
# API_PREFIX=/api/v1
